{
  "name": "@onestep/client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript ExecutionClient for onestep tracked execution (worker stays Python).",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:unit": "node --test --experimental-strip-types tests/canonical.test.ts",
    "test:e2e": "node --test --experimental-strip-types tests/e2e.test.ts",
    "golden": "python3 fixtures/generate_golden.py"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
